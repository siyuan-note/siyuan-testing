{
  "name": "siyuan-testing",
  "version": "1.0.0",
  "description": "Integration testing for SiYuan",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "test:repeat": "playwright test --repeat-each=10",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^25.6.2",
    "typescript": "4.9.5"
  }
}
